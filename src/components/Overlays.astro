---
import { COMMENT_LIMITS } from "../lib/comments";
import IdeaNote from "./IdeaNote.astro";
/* The compose overlay holding the Idea Note, the status toast, and the letter a caught plane opens into. */
---
<div class="letter compose" id="compose" role="dialog" aria-modal="true" aria-label="Share your idea" hidden><div class="note-slot" id="note-slot"><IdeaNote /></div></div>
<p class="toast" id="toast" role="status" hidden></p>

<div class="letter" id="letter" role="dialog" aria-modal="true" aria-labelledby="letter-from" hidden>
  <div class="letter-card">
    <div class="note-head"><span class="note-label">Idea Note · Public</span><button class="letter-close" id="letter-close" type="button" aria-label="Close">✕</button></div>
    <p class="letter-from" id="letter-from"></p>
    <p class="letter-date" id="letter-date"></p>
    <p class="letter-body" id="letter-body"></p>
    <div class="letter-bar">
      <button class="act act-like" id="like-btn" type="button" aria-pressed="false" aria-label="Like this idea">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.3s-7.4-4.5-9.2-9C1.5 8 3.6 4.6 7 4.6c2.1 0 3.6 1.2 5 3 1.4-1.8 2.9-3 5-3 3.4 0 5.5 3.4 4.2 6.7-1.8 4.5-9.2 9-9.2 9z"/></svg>
        <span class="act-count" id="like-count"></span>
      </button>
      <button class="act act-comment" id="comment-btn" type="button" aria-expanded="false" aria-controls="thread-form" aria-label="Write a comment">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 5h15a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H12l-5 3.6V17H4.5A1.5 1.5 0 0 1 3 15.5v-9A1.5 1.5 0 0 1 4.5 5z"/></svg>
        <span class="act-count" id="comment-count"></span>
      </button>
    </div>
    <div class="letter-actions">
      <button type="button" class="danger" id="letter-remove" hidden>Remove this idea</button>
    </div>
    <section class="thread" id="thread" aria-labelledby="thread-title">
      <div class="thread-head"><h3 class="thread-title" id="thread-title">Comments</h3><span class="thread-count" id="thread-count"></span></div>
      <p class="thread-status" id="thread-status" role="status" hidden></p>
      <ol class="thread-list" id="thread-list"></ol>
      <form class="thread-form" id="thread-form" novalidate>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp">
        <label class="note-field" for="comment-msg"><span>Your comment</span>
          <textarea id="comment-msg" name="message" rows="2" maxlength={COMMENT_LIMITS.message} placeholder="Add your thoughts"></textarea>
        </label>
        <label class="note-field" for="comment-name"><span>Your name <span class="opt">(optional, shown with your comment)</span></span>
          <input id="comment-name" name="name" type="text" autocomplete="name" maxlength={COMMENT_LIMITS.name} placeholder="Nino Beridze">
        </label>
        <p class="note-error" id="comment-error" role="alert" hidden></p>
        <button class="thread-send" type="submit">Add comment</button>
      </form>
    </section>
  </div>
</div>
