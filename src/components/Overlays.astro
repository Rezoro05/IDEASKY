---
import { COMMENT_LIMITS } from "../lib/comments";
import IdeaNote from "./IdeaNote.astro";
import SignIn from "./SignIn.astro";
import Feedback from "./Feedback.astro";
import LinkRows from "./LinkRows.astro";
import { UPDATE_LIMITS } from "../lib/updates";
import { STAGES, stageLabel } from "../lib/stages";
/* The compose overlay holding the Idea Note, the status toast, and the letter a caught plane opens into. */
---
<div class="letter compose" id="compose" role="dialog" aria-modal="true" aria-label="Share your idea" hidden><div class="note-slot" id="note-slot"><IdeaNote /></div></div>
<div class="letter compose" id="feedback" role="dialog" aria-modal="true" aria-label="Send feedback" hidden><div class="note-slot" id="feedback-slot"><Feedback /></div></div>
<div class="letter compose" id="signin" role="dialog" aria-modal="true" aria-label="Sign in" hidden><div class="note-slot" id="signin-slot"><SignIn /></div></div>
<p class="toast" id="toast" role="status" hidden></p>
<!-- Browse: every idea or dream, not just the few flying or swimming, newest first, by category, with older ones on request (islands/browse) -->
<div class="letter compose" id="browse" role="dialog" aria-modal="true" aria-labelledby="browse-title" hidden><div class="note-slot browse-slot" id="browse-slot">
  <div class="note browse">
    <div class="note-head"><span class="note-label" id="browse-title">All ideas</span></div>
    <button class="note-close" type="button" id="browse-close" aria-label="Close">✕</button>
    <div class="browse-chips" id="browse-chips" role="group" aria-label="Show a category"></div>
    <ul class="browse-list" id="browse-list"></ul>
    <p class="browse-empty" id="browse-empty" hidden></p>
    <p class="inline-error" id="browse-error" role="alert" hidden></p>
    <button class="text-btn browse-more" type="button" id="browse-more" hidden>Show older</button>
  </div>
</div></div>

<div class="letter" id="letter" role="dialog" aria-modal="true" aria-labelledby="letter-from" hidden>
  <div class="letter-card">
    <div class="note-head"><p class="letter-from" id="letter-from"></p><button class="letter-close" id="letter-close" type="button" aria-label="Close">✕</button></div>
    <header class="letter-head">
      <div class="stage-track" id="stage-track" role="radiogroup" aria-label="Stage">
        <div class="stage-bar" aria-hidden="true">
          <span class="rail"></span><span class="fill"></span>
          {STAGES.map((_, i) => <i class="stop" style={`left:${(i * 100) / (STAGES.length - 1)}%`}></i>)}
          <span class="knob"></span>
        </div>
        <div class="stage-labels">
          {STAGES.map((st) => <label data-stage={st}><input type="radio" name="idea-stage" value={st} disabled />{stageLabel(st)}</label>)}
        </div>
      </div>
      <p class="inline-error" id="stage-error" role="alert" hidden></p>
    </header>

    <div class="letter-content">
      <p class="letter-body" id="letter-body"></p>
      <ul class="letter-links" id="letter-links" hidden></ul>
      <div class="letter-meta"><!-- who and when on the left, its categories on the right -->
        <p class="letter-date" id="letter-date"></p>
        <ul class="letter-cats" id="letter-cats" aria-label="Categories" hidden></ul>
      </div>
    </div>

    <div class="letter-bar">
      <button class="act act-like" id="like-btn" type="button" aria-pressed="false" aria-label="Like this idea">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.3s-7.4-4.5-9.2-9C1.5 8 3.6 4.6 7 4.6c2.1 0 3.6 1.2 5 3 1.4-1.8 2.9-3 5-3 3.4 0 5.5 3.4 4.2 6.7-1.8 4.5-9.2 9-9.2 9z"/></svg>
        <span class="act-count" id="like-count"></span>
      </button>
      <button class="act act-comment" id="comment-btn" type="button" aria-expanded="false" aria-controls="thread-form" aria-label="Write a comment">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 5h15a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H12l-5 3.6V17H4.5A1.5 1.5 0 0 1 3 15.5v-9A1.5 1.5 0 0 1 4.5 5z"/></svg>
        <span class="act-count" id="comment-count"></span>
      </button>
      <button class="act act-share" id="share-btn" type="button" aria-label="Share this idea">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 3 10.5 13.5M21 3l-6.5 18-4-7.5L3 9.5 21 3z"/></svg>
        <span class="act-count" id="share-status" role="status"></span>
      </button>
      <span class="owner-acts">
        <button class="act act-public" id="go-public-btn" type="button" aria-expanded="false" aria-controls="go-public" aria-label="Share on the public board" title="Share on the public board" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.4 3.6 5.3 3.6 8.5s-1 6.1-3.6 8.5M12 3.5C9.4 5.9 8.4 8.8 8.4 12s1 6.1 3.6 8.5"/></svg>
        </button>
        <button class="act act-add" id="add-update" type="button" aria-expanded="false" aria-controls="update-form" aria-label="Add update" title="Add update" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </button>
        <button class="act act-bin" id="letter-remove" type="button" aria-label="Remove this idea" title="Remove this idea" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13M10 11v5.5M14 11v5.5"/></svg>
        </button>
      </span>
    </div>

    <section class="owner" aria-label="Your idea">
      <div class="confirm" id="remove-confirm" role="group" aria-labelledby="remove-question" hidden>
        <p id="remove-question">Remove this idea for good?</p>
        <button type="button" class="confirm-yes danger" id="remove-yes">Yes, remove it</button>
        <button type="button" class="text-btn quiet" id="remove-cancel">Cancel</button>
      </div>
      <p class="inline-error" id="remove-error" role="alert" hidden></p>
      <!-- Your own idea or dream: share a copy on the public board (islands/go-public) -->
      <div class="go-public" id="go-public" hidden>
        <div class="confirm go-public-ask" id="go-public-ask" role="group" aria-labelledby="go-public-q" hidden>
          <p id="go-public-q">Share this on the public board? Anyone will be able to read it. Yours stays here.</p>
          <label class="note-field" for="go-public-name"><span>Your name (optional)</span>
            <input id="go-public-name" type="text" autocomplete="name" maxlength="40" placeholder="Anonymous">
          </label>
          <div class="go-public-choice">
            <button type="button" class="confirm-yes" id="go-public-yes">Share it</button>
            <button type="button" class="text-btn quiet" id="go-public-cancel">Cancel</button>
          </div>
        </div>
        <p class="go-public-done" id="go-public-done" hidden><span>On the public board.</span> <button type="button" class="text-btn" id="go-public-down">Take it down</button></p>
        <p class="inline-error" id="go-public-error" role="alert" hidden></p>
      </div>
    </section>

    <section class="updates" id="updates" aria-labelledby="updates-title" hidden>
      <div class="thread-head"><h3 class="thread-title" id="updates-title">Updates</h3><span class="thread-count" id="updates-count"></span></div>
      <p class="thread-status" id="updates-status" role="status" hidden></p>
      <ol class="updates-list" id="updates-list"></ol>
      <form class="update-form" id="update-form" novalidate hidden>
        <label class="note-field" for="update-msg"><span>What’s new</span>
          <textarea id="update-msg" name="message" rows="3" maxlength={UPDATE_LIMITS.message} placeholder="Built a prototype, found a partner…"></textarea>
        </label>
        <div id="update-link-rows"><LinkRows /></div>
        <p class="note-error" id="update-error" role="alert" hidden></p>
        <div class="update-actions">
          <button type="submit" class="update-send">Post update</button>
          <button type="button" class="text-btn quiet" id="update-cancel">Cancel</button>
        </div>
      </form>
    </section>

    <section class="thread" id="thread" aria-label="Comments">
      <p class="thread-status" id="thread-status" role="status" hidden></p>
      <ol class="thread-list" id="thread-list"></ol>
      <form class="thread-form" id="thread-form" novalidate>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp">
        <p class="reply-to" id="reply-to" hidden><span class="reply-to-name"></span><button type="button" class="reply-cancel" aria-label="Cancel reply">×</button></p>
        <label class="note-field" for="comment-msg"><span>Comment</span>
          <textarea id="comment-msg" name="message" rows="2" maxlength={COMMENT_LIMITS.message} placeholder="Add your thoughts"></textarea>
        </label>
        <label class="note-field" for="comment-name"><span>Name</span>
          <input id="comment-name" name="name" type="text" autocomplete="name" maxlength={COMMENT_LIMITS.name} placeholder="Steve Gates">
        </label>
        <p class="note-error" id="comment-error" role="alert" hidden></p>
        <button class="thread-send" type="submit">Add comment</button>
      </form>
    </section>
  </div>
</div>
