---
/* The sky: headline over the plane field, the New York skyline picture along the bottom, clouds drifting above it.
   The picture ships as AVIF (45 KB) with the WebP (72 KB) for browsers without AVIF. No smaller sizes: it is cropped to cover, so phones draw it wider than the screen.
   Planes are added by the Sky island; without motion the plain list below is the way in. */
import Clouds from "./Clouds.astro";
import Cage from "./Cage.astro";
import { HERO } from "../content/site";
---
<section class="field" id="field" aria-label="Ideas in flight">
  <picture><source srcset="skyline.avif" type="image/avif" /><img class="skyline" src="skyline.webp" width="1983" height="793" alt="" decoding="async" fetchpriority="high" draggable="false" /></picture>
  <Clouds />
  <div class="thesis">
    <h1>{HERO.headline}</h1>
    <p>{HERO.lede}</p>
    <div class="actions">
      <button class="btn btn-idea" type="button" id="idea-btn" aria-haspopup="dialog">Share Your Idea</button>
    </div>
  </div>
  <Cage />
</section>

<div id="fallback" hidden>
  <div id="ideas-fallback" hidden>
    <div class="list-head">
      <h2>Ideas</h2>
      <span>Shown because reduced motion is on</span>
    </div>
    <ul class="ideas" id="ideas-list"></ul>
  </div>
</div>
