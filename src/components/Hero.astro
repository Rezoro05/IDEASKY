---
/* The sky: headline over the plane field. Planes are added by the Sky island; without motion the plain list below is the way in. */
import { HERO } from "../content/site";
---
<section class="field" id="field" aria-label="Ideas in flight">
  <div class="thesis">
    <h1>{HERO.headline}</h1>
    <p>{HERO.lede}</p>
    <div class="actions">
      <button class="btn btn-idea" type="button" id="idea-btn" aria-haspopup="dialog">Share Your Idea</button>
    </div>
  </div>
</section>

<div id="fallback" hidden>
  <div id="ideas-fallback" hidden>
    <div class="list-head">
      <h2>Ideas</h2>
      <span>Shown because reduced motion is on</span>
    </div>
    <ul class="ideas" id="ideas-list"></ul>
  </div>
</div>
