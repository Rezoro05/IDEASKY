---
/* The small net, at the bottom of the sea. Hold a fish (a dream) and drop it here to read it, as a bird is dropped in the cage.
   The sea measures this element to know where a drop counts; it is not a control (keyboard users open dreams directly), so it is not focusable. */
const HINT = "Catch a dream and drop it in the net to read it.";
---
<div class="fish-net" id="fish-net" role="img" aria-label={HINT}>
  <svg viewBox="-30 -34 60 68" aria-hidden="true"><!-- drawn to fill the same box as the cage -->
    <path class="fn-handle-edge" d="M22 -22 L29 -33"></path><path class="fn-handle" d="M22 -22 L29 -33"></path>
    <path class="fn-bag" d="M-26 -20 C-26 8 -12 30 0 30 C12 30 26 8 26 -20 Z"></path>
    <path class="fn-mesh" d="M-13 -27.5 Q-12 12 -4 29 M0 -28 L0 30 M13 -27.5 Q12 12 4 29 M-25 -6 Q0 1 25 -6 M-20 10 Q0 16 20 10"></path>
    <ellipse class="fn-rim" cx="0" cy="-20" rx="26" ry="7.5"></ellipse>
  </svg>
  <span class="net-hint">{HINT}</span>
</div>
