---
/* The sign-in note: the same paper as the Idea Note. One email field; we send a link (Supabase magic link), so there is no password.
   After sending, the note says where the link went. The account button (top right) opens it; islands/account runs it. */
import { EMAIL_MAX } from "../lib/account";
---
<form class="note signin-form" id="signin-form" novalidate>
  <div class="note-head">
    <span class="note-label">Sign in</span>
    <span class="note-to">Your board</span>
    <button class="note-close" type="button" id="signin-close" aria-label="Close">✕</button>
  </div>
  <div class="signin-ask" id="signin-ask">
    <p class="signin-lede">Your own board for private ideas and dreams. No password: continue with Google, or we’ll email you a link.</p>
    <div class="signin-google-wrap" id="signin-google-wrap" hidden>
      <button class="signin-google" type="button" id="signin-google">
        <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Continue with Google
      </button>
      <p class="signin-or"><span>or by email</span></p>
    </div>
    <label class="note-field" for="signin-email"><span>Email</span>
      <input id="signin-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength={EMAIL_MAX} placeholder="you@company.com" required aria-required="true">
    </label>
    <p class="note-error" id="signin-error" role="alert" hidden></p>
    <div class="note-choice">
      <button class="feedback-send signin-send" type="submit">Email me a link <span aria-hidden="true">→</span></button>
    </div>
  </div>
  <div class="signin-sent" id="signin-sent" hidden>
    <p class="signin-lede" role="status">Check your email. We sent a sign-in link to <strong id="signin-to"></strong>. Open it on this device.</p>
    <button class="text-btn" type="button" id="signin-again">Use a different email</button>
  </div>
</form>
