---
/* The cage, bottom right of the sky (bottom centre on a phone, on top of Dive). Catch a bird (a live idea) and drop it here to read it. The sky measures this element to know where a drop counts;
   it is not a control (keyboard users open ideas directly), so it is not focusable. */
const HINT = "Catch an idea and put it in the cage to see it.";
---
<div class="cage" id="cage" role="img" aria-label={HINT}>
  <svg viewBox="-30 -34 60 68" aria-hidden="true">
    <path class="cage-ring" d="M-4 -30 Q0 -36 4 -30"></path>
    <path class="cage-body" d="M-24 20 L-24 -2 Q-24 -24 0 -26 Q24 -24 24 -2 L24 20 Z"></path>
    <path class="cage-bars" d="M-14 -24 L-14 20 M-5 -26 L-5 20 M5 -26 L5 20 M14 -24 L14 20"></path>
    <rect class="cage-base" x="-27" y="20" width="54" height="7" rx="2.5"></rect>
  </svg>
  <span class="cage-hint">{HINT}</span>
</div>
