---
/* The Idea Note: the paper form a visitor writes an idea on. It lives in the compose overlay opened by "Share Your Idea".
   The idea comes first; who wrote it is optional and sits below. */
import { IDEA_LIMITS } from "../lib/ideas";
import { LINK_LIMITS } from "../lib/links";
---
<form class="note" id="note-form" novalidate>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp">
  <div class="note-head">
    <span class="note-label">Idea Note</span>
    <span class="note-to">Public</span>
    <button class="note-close" type="button" id="note-close" aria-label="Close">✕</button>
  </div>
  <label class="note-field note-idea" for="note-msg"><span>The idea <span class="req" aria-hidden="true">*</span></span>
    <textarea id="note-msg" name="message" rows="4" maxlength={IDEA_LIMITS.message} required aria-required="true" placeholder="Share anything on your mind"></textarea>
  </label>
  <div class="note-links">
    <ol class="link-rows" id="link-rows"></ol>
    <button type="button" class="add-link" id="add-link">+ Add link</button>
  </div>
  <template id="link-row"><li class="link-row">
    <input class="link-url" type="text" inputmode="url" autocomplete="url" maxlength={LINK_LIMITS.url} placeholder="example.com" aria-label="Link address">
    <input class="link-title" type="text" maxlength={LINK_LIMITS.title} placeholder="Title (optional)" aria-label="Link title">
    <button type="button" class="link-remove" aria-label="Remove this link">✕</button>
  </li></template>
  <div class="note-who">
    <label class="note-field" for="note-name"><span>Name</span>
      <input id="note-name" name="name" type="text" autocomplete="name" maxlength={IDEA_LIMITS.name} placeholder="Nino Beridze">
    </label>
    <label class="note-field" for="note-email"><span>Email</span>
      <input id="note-email" name="email" type="text" inputmode="email" autocomplete="email" placeholder="you@company.com">
    </label>
  </div>
  <p class="note-error" id="note-error" role="alert" hidden></p>
  <div class="note-choice">
    <button class="note-send" type="submit">Fold &amp; share <span aria-hidden="true">→</span></button>
  </div>
</form>
