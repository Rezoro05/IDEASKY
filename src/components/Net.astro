---
/* The net, top right of the sea (like the cage in the sky). Grab a fish (a dream) and drop it here: it stays in the net until it is tapped.
   The sea measures this element to know where a drop counts; it is not a control (keyboard users open dreams directly), so it is not focusable. */
const HINT = "Catch a dream and drop it in the net to keep it.";
---
<div class="net" id="net" role="img" aria-label={HINT}>
  <svg viewBox="-30 -34 60 68" aria-hidden="true">
    <path class="net-handle" d="M18 -20 L29 -32"></path>
    <path class="net-bag" d="M-22 -14 Q-20 18 0 26 Q20 18 22 -14"></path>
    <path class="net-mesh" d="M-15 -14 Q-12 12 0 26 M-5 -14 Q-4 14 0 26 M5 -14 Q4 14 0 26 M15 -14 Q12 12 0 26 M-21 -2 Q0 4 21 -2 M-17 10 Q0 15 17 10"></path>
    <ellipse class="net-hoop" cx="0" cy="-14" rx="22" ry="6"></ellipse>
  </svg>
  <span class="net-hint">{HINT}</span>
</div>
