---
/* The one page: the sky and the overlays. It ships as real HTML before any script runs. */
import rawCss from "../styles/site.css?raw";
import { transform } from "esbuild";
import Loader from "../components/Loader.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Overlays from "../components/Overlays.astro";
import Sea from "../components/Sea.astro";
import { SITE, type PageMeta } from "../content/site";

type Props = { meta: PageMeta; noindex?: boolean };
const { meta, noindex = false } = Astro.props as Props;
/** The stylesheet is inlined, so it ships minified; the source keeps its comments. URLs stay as written (they resolve against <base>). */
const css = (await transform(rawCss, { loader: "css", minify: true })).code;
const ld = { "@context": "https://schema.org", "@type": "WebSite", name: SITE.name, url: SITE.url, description: meta.description };
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<base href={import.meta.env.BASE_URL}>
<title>{meta.title}</title>
<meta name="description" content={meta.description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={SITE.url}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={meta.title}>
<meta property="og:description" content={meta.description}>
<meta property="og:url" content={SITE.url}>
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<link rel="preload" href="fonts/poppins-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="fonts/ibm-plex-sans-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="fonts/poppins-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
<style is:inline set:html={css}></style>
</head>
<body>
<Loader />
<div class="wrap">
  <div class="world" id="world">
    <div class="sky-part" id="sky-part">
      <Header />
      <main id="view-home">
        <Hero />
      </main>
    </div>
    <Sea />
  </div>
</div>
<Overlays />
<script>
  import { startSite } from "../islands/app";
  startSite();
</script>
</body>
</html>
